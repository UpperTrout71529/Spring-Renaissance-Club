{%- comment -%}
  SPRING RENAISSANCE — sr-members-object.liquid (V2, docs/tz-v2-circle.md §8.4)
  The members' object page: image, text, "Members only" and the way into the
  Circle. There is deliberately no product form and no add to cart: the
  object is bought only from the portal (club.springrenaissance.store/circle/object).
  Felix places this section on a Page; nothing is named until he fills it in.
  Namespace: .srmo
{%- endcomment -%}

<section class="srmo" data-srmo>
  <div class="srmo__inner">
    {%- if section.settings.image != blank -%}
      <div class="srmo__media">
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400,800,1200,1600', alt: section.settings.image.alt | default: section.settings.heading | escape }}
      </div>
    {%- endif -%}
    <div class="srmo__content">
      <p class="srmo__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- if section.settings.heading != blank -%}
        <h1 class="srmo__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="srmo__text">{{ section.settings.text }}</div>
      {%- endif -%}
      <p class="srmo__note">{{ section.settings.members_line }}</p>
      <p class="srmo__links">
        <a class="srmo__button" href="https://club.springrenaissance.store/circle/object">{{ section.settings.member_cta }}</a>
        <a class="srmo__link" href="https://club.springrenaissance.store/circle">{{ section.settings.about_label }}</a>
      </p>
    </div>
  </div>
</section>

{% stylesheet %}
  .srmo { background: #FBFBF9; color: #1A1918; }
  .srmo__inner { display: grid; gap: 32px; max-width: 1240px; margin: 0 auto; padding: 64px 24px; }
  .srmo__media img { display: block; width: 100%; height: auto; }
  .srmo__eyebrow { margin: 0 0 12px; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.7; }
  .srmo__title { margin: 0 0 16px; font-weight: 400; font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; }
  .srmo__text { max-width: 52ch; line-height: 1.7; }
  .srmo__note { margin: 24px 0 0; font-size: 15px; }
  .srmo__links { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin: 24px 0 0; }
  .srmo__button { display: inline-block; padding: 16px 28px; background: #1A1918; color: #FBFBF9; text-decoration: none; font-size: 13px; letter-spacing: 0.08em; }
  .srmo__link { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 900px) {
    .srmo__inner { grid-template-columns: 1.1fr 1fr; align-items: center; padding: 96px 48px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SR — Members' object",
  "tag": "section",
  "class": "srmo-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Members only" },
    { "type": "text", "id": "heading", "label": "Title (leave empty until the object is named)" },
    { "type": "richtext", "id": "text", "label": "Description" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "members_line", "label": "Members line", "default": "Available to members of the Renaissance Circle." },
    { "type": "text", "id": "member_cta", "label": "Members' button", "default": "Members: reserve yours" },
    { "type": "text", "id": "about_label", "label": "About link", "default": "About the Circle" }
  ],
  "presets": [{ "name": "SR — Members' object" }]
}
{% endschema %}
