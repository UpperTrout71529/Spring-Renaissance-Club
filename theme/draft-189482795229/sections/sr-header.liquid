{%- comment -%}
  SPRING RENAISSANCE — sr-header.liquid
  Fixed masthead. Left index trigger, centred wordmark, Circle monogram
  and bag mark. Full-bleed overlay drawer, vanilla JS, no dependencies.

  CONTRAST
  The bar sits over sections of alternating tone, so one fixed ink colour
  cannot work everywhere. Three modes, set under Behaviour:
    solid    - opaque ground at all times. No failure modes.
    veil     - clear over the first section, opaque once scrolled. Default.
    adaptive - clear throughout; ink flips to dark over light sections.
  A scrim gradient sits behind the bar while it is clear, so white type
  survives a light-toned hero image without a spacer beneath it.

  Alpha is applied with color_modify, never by appending hex digits.
  A colour setting may return "#1A1918" or "rgba(26,25,24,1)"; appending
  "D9" to the second form yields invalid CSS, the declaration is dropped,
  and the bar stays transparent.

  Install: Edit code > Sections > Add a new section > name it
  "sr-header", paste this file whole. Then Theme editor >
  Header group > Add section > "SR — Header", and remove or hide the
  theme's default Header so only one masthead renders.

  Renders as <header> via "tag": "header" in the schema.
{%- endcomment -%}

{%- assign circle_url = section.settings.circle_url | default: '/products/patron-membership' -%}
{%- comment -%} LK spec §9.2.7: Account → the member portal. {%- endcomment -%}
{%- assign account_url = section.settings.account_url | default: 'https://club.springrenaissance.store' -%}
{%- assign menu = section.settings.main_menu -%}
{%- assign mode = section.settings.mode -%}
{%- assign veil_alpha = section.settings.veil_opacity | divided_by: 100.0 -%}
{%- assign scrim_alpha = section.settings.scrim_strength | divided_by: 100.0 -%}
{%- assign drawer_alpha = section.settings.drawer_opacity | divided_by: 100.0 -%}

{%- comment -%} Overlay only where a full-bleed hero sits directly beneath. {%- endcomment -%}
{%- assign overlay = false -%}
{%- if section.settings.overlay_home and template.name == 'index' and mode != 'solid' -%}
  {%- assign overlay = true -%}
{%- endif -%}

{% style %}
  #shopify-section-{{ section.id }}{
    --sr-ground:{{ section.settings.bg_color }};
    --sr-ink:{{ section.settings.text_color }};
    --sr-ink-dark:{{ section.settings.text_color_dark }};
    --sr-accent:{{ section.settings.accent_color }};
    --sr-accent-dark:{{ section.settings.accent_color | color_darken: 12 }};
    --sr-hair:{{ section.settings.text_color | color_modify: 'alpha', 0.14 }};
    --sr-hair-dark:{{ section.settings.text_color_dark | color_modify: 'alpha', 0.16 }};
    --sr-serif:'Cormorant Garamond','Times New Roman',Georgia,serif;
    --sr-sans:'Inter','Montserrat',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    --sr-h:{{ section.settings.height_mobile }}px;
    --sr-dr-bg:{{ section.settings.drawer_bg }};
    --sr-dr-ink:{{ section.settings.drawer_ink }};
    --sr-dr-accent:{{ section.settings.accent_color }};
    --sr-dr-accent-deep:{{ section.settings.accent_color | color_darken: 14 }};
    --sr-dr-hair:{{ section.settings.drawer_ink | color_modify: 'alpha', 0.08 }};
    --sr-dr-hair-soft:{{ section.settings.drawer_ink | color_modify: 'alpha', 0.045 }};
    --sr-dr-wash:{{ section.settings.accent_color | color_modify: 'alpha', 0.07 }};
    --sr-dr-glow:{{ section.settings.accent_color | color_modify: 'alpha', 0.18 }};
    --sr-ease:cubic-bezier(.22,1,.36,1);
  }

  {%- comment -%}
    The wrapper stays in normal flow and reserves the masthead height,
    so content on inner templates does not slide underneath. On the home
    page it collapses to zero and the hero runs full-bleed behind the bar.
  {%- endcomment -%}
  #shopify-section-{{ section.id }}{
    position:relative;z-index:60;
    height:{% if overlay %}0{% else %}var(--sr-h){% endif %};
  }
  #shopify-section-{{ section.id }} *{box-sizing:border-box;}

  /* ---------- masthead ---------- */
  #shopify-section-{{ section.id }} .sr-head{
    position:fixed;top:0;left:0;right:0;
    height:var(--sr-h);
    color:var(--sr-ink);
    border-bottom:1px solid transparent;
    transition:background-color .6s var(--sr-ease),
               border-color .6s var(--sr-ease),
               color .45s var(--sr-ease);
  }

  {%- if mode == 'solid' -%}

    #shopify-section-{{ section.id }} .sr-head{
      background:var(--sr-ground);
      border-bottom-color:var(--sr-hair);
    }

  {%- else -%}

    /* protective gradient while the bar is clear */
    #shopify-section-{{ section.id }} .sr-head::before{
      content:"";position:absolute;left:0;right:0;top:0;
      height:220%;pointer-events:none;
      background:linear-gradient(180deg,
        rgba(0,0,0,{{ scrim_alpha }}) 0%,
        rgba(0,0,0,0) 100%);
      opacity:{% if section.settings.scrim %}1{% else %}0{% endif %};
      transition:opacity .6s var(--sr-ease);
    }

    {%- if mode == 'veil' -%}
      #shopify-section-{{ section.id }} .sr-head.is-veiled{
        background:{{ section.settings.bg_color | color_modify: 'alpha', veil_alpha }};
        -webkit-backdrop-filter:blur(12px);
                backdrop-filter:blur(12px);
        border-bottom-color:var(--sr-hair);
      }
      #shopify-section-{{ section.id }} .sr-head.is-veiled::before{opacity:0;}
    {%- endif -%}

    {%- if mode == 'adaptive' -%}
      #shopify-section-{{ section.id }} .sr-head.is-inverted{
        color:var(--sr-ink-dark);
        --sr-ink:var(--sr-ink-dark);
        --sr-accent:var(--sr-accent-dark);
        border-bottom-color:var(--sr-hair-dark);
      }
      #shopify-section-{{ section.id }} .sr-head.is-inverted::before{opacity:0;}
    {%- endif -%}

  {%- endif -%}

  #shopify-section-{{ section.id }} .sr-head__bar{
    position:relative;
    height:100%;
    max-width:{{ section.settings.max_width }}px;margin:0 auto;
    padding:0 16px;
    display:grid;grid-template-columns:1fr auto 1fr;align-items:center;
    column-gap:12px;
  }
  #shopify-section-{{ section.id }} .sr-head__zone--r{
    display:flex;align-items:center;justify-content:flex-end;gap:4px;
  }

  /* ---------- shared control ---------- */
  #shopify-section-{{ section.id }} .sr-ctl{
    display:inline-flex;align-items:center;gap:11px;
    background:none;border:0;padding:10px 8px;margin:0 -8px;
    color:inherit;text-decoration:none;cursor:pointer;
    font-family:var(--sr-sans);font-weight:500;font-size:10px;
    letter-spacing:.22em;text-transform:uppercase;
    transition:color .5s var(--sr-ease),letter-spacing .5s var(--sr-ease);
  }
  #shopify-section-{{ section.id }} .sr-ctl:hover{color:var(--sr-accent);}
  #shopify-section-{{ section.id }} .sr-ctl:focus-visible{
    outline:1px solid var(--sr-accent);outline-offset:3px;
  }
  #shopify-section-{{ section.id }} .sr-ctl__label{display:none;}
  #shopify-section-{{ section.id }} .sr-glyph{
    display:block;width:22px;height:22px;flex:0 0 auto;overflow:visible;
  }
  #shopify-section-{{ section.id }} .sr-vh{
    position:absolute;width:1px;height:1px;padding:0;margin:-1px;
    overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;
  }

  /* index rules glyph — middle rule reaches out on hover */
  #shopify-section-{{ section.id }} .sr-glyph__rule{
    transition:transform .55s var(--sr-ease);transform-origin:0 50%;
  }
  #shopify-section-{{ section.id }} .sr-ctl:hover .sr-glyph__rule--2{transform:scaleX(1.55);}
  #shopify-section-{{ section.id }} .sr-ctl:hover .sr-glyph__rule--3{transform:scaleX(.72);}

  /* tulip glyph — petals part on hover */
  #shopify-section-{{ section.id }} .sr-glyph__petal{
    transition:transform .6s var(--sr-ease);transform-origin:12px 14px;
  }
  #shopify-section-{{ section.id }} .sr-ctl:hover .sr-glyph__petal--l{transform:rotate(-7deg);}
  #shopify-section-{{ section.id }} .sr-ctl:hover .sr-glyph__petal--r{transform:rotate(7deg);}

  /* ---------- wordmark ---------- */
  #shopify-section-{{ section.id }} .sr-head__logo{
    display:block;text-decoration:none;color:inherit;
    font-family:var(--sr-serif);font-weight:300;
    font-size:{{ section.settings.logo_size_mobile }}px;
    line-height:1;letter-spacing:.18em;text-transform:uppercase;
    white-space:nowrap;text-indent:.18em;
    transition:color .5s var(--sr-ease);
  }
  #shopify-section-{{ section.id }} .sr-head__logo:hover{color:var(--sr-accent);}
  #shopify-section-{{ section.id }} .sr-head__logo:focus-visible{
    outline:1px solid var(--sr-accent);outline-offset:6px;
  }
  #shopify-section-{{ section.id }} .sr-head__logo img{
    display:block;height:{{ section.settings.logo_size_mobile }}px;width:auto;
  }

  /* ---------- bag ---------- */
  #shopify-section-{{ section.id }} .sr-bag{position:relative;}
  #shopify-section-{{ section.id }} .sr-bag__count{
    position:absolute;top:4px;right:1px;
    font-family:var(--sr-sans);font-weight:500;font-size:9px;
    letter-spacing:.04em;color:var(--sr-accent);
    line-height:1;pointer-events:none;
  }
  #shopify-section-{{ section.id }} .sr-bag__count[hidden]{display:none;}

  /* ---------- drawer ---------- */
  #shopify-section-{{ section.id }} .sr-drawer{
    position:fixed;inset:0;z-index:70;
    display:flex;flex-direction:column;
    background:{{ section.settings.drawer_bg | color_modify: 'alpha', drawer_alpha }};
    -webkit-backdrop-filter:blur(28px) saturate(1.18);
            backdrop-filter:blur(28px) saturate(1.18);
    color:var(--sr-dr-ink);
    opacity:0;visibility:hidden;
    transition:opacity .5s var(--sr-ease),visibility .5s var(--sr-ease);
  }
  /* No frosted glass — go nearly opaque rather than let type sit on noise. */
  @supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){
    #shopify-section-{{ section.id }} .sr-drawer{
      background:{{ section.settings.drawer_bg | color_modify: 'alpha', 0.985 }};
    }
  }
  #shopify-section-{{ section.id }} .sr-drawer.is-open{opacity:1;visibility:visible;}
  /* display:flex above outranks the UA [hidden] rule — restate it. */
  #shopify-section-{{ section.id }} .sr-drawer[hidden]{display:none;}

  #shopify-section-{{ section.id }} .sr-drawer__bar{
    flex:0 0 auto;height:var(--sr-h);
    max-width:{{ section.settings.max_width }}px;width:100%;margin:0 auto;
    padding:0 16px;
    display:flex;align-items:center;justify-content:space-between;
    border-bottom:1px solid var(--sr-dr-hair-soft);
  }
  #shopify-section-{{ section.id }} .sr-drawer__eyebrow{
    font-family:var(--sr-sans);font-weight:500;font-size:10px;
    letter-spacing:.26em;text-transform:uppercase;color:var(--sr-dr-accent-deep);
    margin:0;
  }
  /* The bar's controls inherit --sr-ink from the masthead; override locally. */
  #shopify-section-{{ section.id }} .sr-drawer .sr-ctl{color:var(--sr-dr-ink);}
  #shopify-section-{{ section.id }} .sr-drawer .sr-ctl:hover{color:var(--sr-dr-accent-deep);}
  #shopify-section-{{ section.id }} .sr-drawer .sr-ctl:focus-visible{
    outline:1px solid var(--sr-dr-accent);outline-offset:3px;
  }

  #shopify-section-{{ section.id }} .sr-drawer__body{
    flex:1 1 auto;overflow-y:auto;-webkit-overflow-scrolling:touch;
    max-width:{{ section.settings.max_width }}px;width:100%;margin:0 auto;
    padding:36px 16px 48px;
  }

  #shopify-section-{{ section.id }} .sr-nav{list-style:none;margin:0;padding:0;}
  #shopify-section-{{ section.id }} .sr-nav__row{
    border-bottom:1px solid var(--sr-dr-hair-soft);
  }
  #shopify-section-{{ section.id }} .sr-nav__row:last-child{border-bottom:0;}

  #shopify-section-{{ section.id }} .sr-nav__link{
    position:relative;
    display:flex;align-items:baseline;gap:18px;
    padding:26px 0;
    text-decoration:none;color:inherit;cursor:pointer;
    -webkit-tap-highlight-color:transparent;
    transition:transform .55s var(--sr-ease),color .45s var(--sr-ease);
  }
  /* Warm wash, drawn behind the type and bled past the body padding. */
  #shopify-section-{{ section.id }} .sr-nav__link::before{
    content:"";position:absolute;top:0;bottom:0;left:-16px;right:-16px;
    background:linear-gradient(90deg,var(--sr-dr-wash) 0%,transparent 64%);
    opacity:0;pointer-events:none;
    transition:opacity .5s var(--sr-ease);
  }
  /* Gold hairline that opens from the centre. */
  #shopify-section-{{ section.id }} .sr-nav__link::after{
    content:"";position:absolute;left:-16px;top:18%;bottom:18%;
    width:1px;background:var(--sr-dr-accent);
    transform:scaleY(0);transform-origin:50% 50%;
    transition:transform .55s var(--sr-ease);
  }
  #shopify-section-{{ section.id }} .sr-nav__link:hover,
  #shopify-section-{{ section.id }} .sr-nav__link:active,
  #shopify-section-{{ section.id }} .sr-nav__link:focus-visible{
    transform:translateX(6px);color:var(--sr-dr-accent-deep);
  }
  #shopify-section-{{ section.id }} .sr-nav__link:hover::before,
  #shopify-section-{{ section.id }} .sr-nav__link:active::before,
  #shopify-section-{{ section.id }} .sr-nav__link:focus-visible::before{opacity:1;}
  #shopify-section-{{ section.id }} .sr-nav__link:hover::after,
  #shopify-section-{{ section.id }} .sr-nav__link:active::after,
  #shopify-section-{{ section.id }} .sr-nav__link:focus-visible::after{transform:scaleY(1);}
  #shopify-section-{{ section.id }} .sr-nav__link:focus-visible{
    outline:1px solid var(--sr-dr-accent);outline-offset:6px;
  }

  #shopify-section-{{ section.id }} .sr-nav__no{
    flex:0 0 auto;
    font-family:var(--sr-sans);font-weight:500;font-size:9px;
    letter-spacing:.22em;color:var(--sr-dr-accent-deep);opacity:.55;
    transition:opacity .45s var(--sr-ease);
  }
  #shopify-section-{{ section.id }} .sr-nav__link:hover .sr-nav__no,
  #shopify-section-{{ section.id }} .sr-nav__link:active .sr-nav__no{opacity:.95;}

  #shopify-section-{{ section.id }} .sr-nav__label{
    font-family:var(--sr-serif);font-weight:300;
    font-size:clamp(1.9rem,8.4vw,2.6rem);line-height:1.04;
    letter-spacing:.02em;text-transform:uppercase;
  }

  /* ---------- Circle row ---------- */
  #shopify-section-{{ section.id }} .sr-nav__row--circle .sr-nav__link{
    color:var(--sr-dr-accent-deep);
  }
  /* Its hairline is always present, just quieter until touched. */
  #shopify-section-{{ section.id }} .sr-nav__row--circle .sr-nav__link::after{
    transform:scaleY(.42);opacity:.5;
    transition:transform .55s var(--sr-ease),opacity .5s var(--sr-ease);
  }
  #shopify-section-{{ section.id }} .sr-nav__row--circle .sr-nav__link:hover::after,
  #shopify-section-{{ section.id }} .sr-nav__row--circle .sr-nav__link:active::after{
    transform:scaleY(1);opacity:1;
  }
  #shopify-section-{{ section.id }} .sr-nav__row--circle .sr-nav__label{
    font-style:italic;
  }
  #shopify-section-{{ section.id }} .sr-nav__vip{
    align-self:center;flex:0 0 auto;
    border:0;border-radius:1px;
    background:var(--sr-dr-glow);
    padding:5px 9px;
    font-family:var(--sr-sans);font-weight:500;font-size:8px;
    letter-spacing:.24em;text-transform:uppercase;color:var(--sr-dr-accent-deep);
  }

  /* ---------- drawer colophon ---------- */
  #shopify-section-{{ section.id }} .sr-drawer__foot{
    margin-top:52px;padding-top:30px;
    border-top:1px solid var(--sr-dr-hair);
    display:grid;grid-template-columns:1fr;gap:26px;
  }
  #shopify-section-{{ section.id }} .sr-drawer__kicker{
    display:flex;align-items:center;gap:12px;margin:0 0 14px;
    font-family:var(--sr-sans);font-weight:500;font-size:10px;
    letter-spacing:.26em;text-transform:uppercase;color:var(--sr-dr-accent-deep);
  }
  #shopify-section-{{ section.id }} .sr-drawer__kicker::after{
    content:"";flex:1 1 auto;height:1px;background:var(--sr-dr-hair-soft);
  }
  #shopify-section-{{ section.id }} .sr-drawer__line{
    display:block;text-decoration:none;color:inherit;
    font-family:var(--sr-serif);font-weight:300;font-size:1.15rem;
    line-height:1.6;opacity:.78;
    -webkit-tap-highlight-color:transparent;
    transition:color .5s var(--sr-ease),opacity .5s var(--sr-ease);
  }
  #shopify-section-{{ section.id }} a.sr-drawer__line:hover,
  #shopify-section-{{ section.id }} a.sr-drawer__line:active{
    color:var(--sr-dr-accent-deep);opacity:1;
  }
  #shopify-section-{{ section.id }} .sr-drawer__meta{
    font-style:normal;
    font-family:var(--sr-sans);font-size:11px;line-height:1.9;
    letter-spacing:.16em;text-transform:uppercase;opacity:.45;
  }

  @media (min-width:900px){
    #shopify-section-{{ section.id }}{--sr-h:{{ section.settings.height_desktop }}px;}
    #shopify-section-{{ section.id }} .sr-head__bar,
    #shopify-section-{{ section.id }} .sr-drawer__bar{padding:0 40px;}
    #shopify-section-{{ section.id }} .sr-drawer__body{padding:72px 40px 80px;}
    #shopify-section-{{ section.id }} .sr-ctl__label{display:inline;}
    #shopify-section-{{ section.id }} .sr-ctl:hover{letter-spacing:.28em;}
    #shopify-section-{{ section.id }} .sr-head__zone--r{gap:22px;}
    #shopify-section-{{ section.id }} .sr-head__logo{
      font-size:{{ section.settings.logo_size_desktop }}px;
    }
    #shopify-section-{{ section.id }} .sr-head__logo img{
      height:{{ section.settings.logo_size_desktop }}px;
    }
    #shopify-section-{{ section.id }} .sr-nav__link{padding:34px 0;}
    #shopify-section-{{ section.id }} .sr-nav__link::before{left:-40px;right:-40px;}
    #shopify-section-{{ section.id }} .sr-nav__link::after{left:-40px;}
    #shopify-section-{{ section.id }} .sr-nav__label{font-size:clamp(2.4rem,4.6vw,3.4rem);}
    #shopify-section-{{ section.id }} .sr-drawer__foot{
      grid-template-columns:repeat(2,1fr);gap:56px;margin-top:80px;
    }
  }

  @media (prefers-reduced-motion:reduce){
    #shopify-section-{{ section.id }} *{transition-duration:.01ms !important;}
  }
{% endstyle %}

<div class="sr-head" data-sr-head>
  <div class="sr-head__bar">

    {%- comment -%} left — index trigger {%- endcomment -%}
    <div class="sr-head__zone sr-head__zone--l">
      <button type="button" class="sr-ctl" data-sr-open
              aria-expanded="false" aria-controls="sr-drawer-{{ section.id }}">
        {%- if section.settings.trigger_glyph == 'tulip' -%}
          <svg class="sr-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path class="sr-glyph__petal sr-glyph__petal--l" d="M12 14c-2.5-1-3.9-3.5-3.7-6.7 1.7 1 3 3.2 3.7 6.7Z"/>
            <path class="sr-glyph__petal sr-glyph__petal--r" d="M12 14c2.5-1 3.9-3.5 3.7-6.7-1.7 1-3 3.2-3.7 6.7Z"/>
            <path d="M12 14c-1-2.7-1-5.7 0-8.5 1 2.8 1 5.8 0 8.5Z"/>
            <path d="M12 14v7"/>
            <path d="M12 17.6c-1.5 0-2.7-1-3.1-2.7 1.7-.2 2.9.6 3.1 2.7Z"/>
          </svg>
        {%- else -%}
          <svg class="sr-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.2" stroke-linecap="round" aria-hidden="true">
            <path class="sr-glyph__rule sr-glyph__rule--1" d="M2.5 7h13"/>
            <path class="sr-glyph__rule sr-glyph__rule--2" d="M2.5 12h8"/>
            <path class="sr-glyph__rule sr-glyph__rule--3" d="M2.5 17h15"/>
          </svg>
        {%- endif -%}
        <span class="sr-ctl__label">{{ section.settings.trigger_label }}</span>
        <span class="sr-vh">{{ section.settings.trigger_label }}</span>
      </button>
    </div>

    {%- comment -%} centre — wordmark {%- endcomment -%}
    <div class="sr-head__zone sr-head__zone--c">
      <a class="sr-head__logo" href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: height: 120 }}"
               alt="{{ section.settings.wordmark | default: shop.name | escape }}"
               width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}">
        {%- else -%}
          {{ section.settings.wordmark | default: shop.name }}
        {%- endif -%}
      </a>
    </div>

    {%- comment -%} right — Circle and bag {%- endcomment -%}
    <div class="sr-head__zone sr-head__zone--r">

      {%- if section.settings.show_circle -%}
        <a class="sr-ctl" href="{{ circle_url }}"
           {% if circle_url contains '://' %}target="_blank" rel="noopener"{% endif %}>
          <svg class="sr-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.2" aria-hidden="true">
            <circle cx="12" cy="12" r="9.2"/>
            <text x="12" y="15.5" text-anchor="middle" stroke="none" fill="currentColor"
                  font-family="Cormorant Garamond, Times New Roman, Georgia, serif"
                  font-size="9.5" font-weight="300" letter-spacing="0.4">RC</text>
          </svg>
          <span class="sr-vh">{{ section.settings.circle_label }}</span>
        </a>
      {%- endif -%}

      <a class="sr-ctl" href="{{ account_url }}">
        <svg class="sr-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="8.6" r="3.6"/>
          <path d="M5 20.2c.7-3.7 3.5-6 7-6s6.3 2.3 7 6"/>
        </svg>
        <span class="sr-vh">{{ section.settings.account_label | default: 'Account' }}</span>
      </a>
      <a class="sr-ctl sr-bag" href="{{ routes.cart_url }}" data-sr-bag>
        <svg class="sr-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4.8 7.4h14.4l-1 12.3a1.4 1.4 0 0 1-1.4 1.3H7.2a1.4 1.4 0 0 1-1.4-1.3L4.8 7.4Z"/>
          <path d="M9 9.2V6.5a3 3 0 0 1 6 0v2.7"/>
        </svg>
        <span class="sr-bag__count" data-sr-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
        <span class="sr-vh" data-sr-count-label>{{ section.settings.bag_label }} ({{ cart.item_count }})</span>
      </a>

    </div>
  </div>
</div>

{%- comment -%} ---------- drawer ---------- {%- endcomment -%}
<div class="sr-drawer" id="sr-drawer-{{ section.id }}" data-sr-drawer
     role="dialog" aria-modal="true" aria-label="{{ section.settings.drawer_eyebrow | escape }}" hidden>

  <div class="sr-drawer__bar">
    <p class="sr-drawer__eyebrow">{{ section.settings.drawer_eyebrow }}</p>
    <button type="button" class="sr-ctl" data-sr-close>
      <span class="sr-ctl__label">{{ section.settings.close_label }}</span>
      <svg class="sr-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.2" stroke-linecap="round" aria-hidden="true">
        <path d="M5.5 5.5l13 13"/><path d="M18.5 5.5l-13 13"/>
      </svg>
      <span class="sr-vh">{{ section.settings.close_label }}</span>
    </button>
  </div>

  <div class="sr-drawer__body">

    <ul class="sr-nav" role="list">
      {%- if menu != blank and menu.links.size > 0 -%}

        {%- for link in menu.links -%}
          {%- assign is_circle = false -%}
          {%- if link.url == circle_url or link.url contains 'patron-membership' -%}
            {%- assign is_circle = true -%}
          {%- endif -%}
          <li class="sr-nav__row{% if is_circle %} sr-nav__row--circle{% endif %}">
            <a class="sr-nav__link" href="{{ link.url }}"
               {% if link.current %}aria-current="page"{% endif %}
               {% if link.url contains '://' %}target="_blank" rel="noopener"{% endif %}>
              <span class="sr-nav__no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="sr-nav__label">{{ link.title }}</span>
              {%- if is_circle -%}<span class="sr-nav__vip">{{ section.settings.vip_badge }}</span>{%- endif -%}
            </a>
          </li>
        {%- endfor -%}

      {%- else -%}

        {%- assign fb_titles = 'Collection,Manifesto,Renaissance Circle,Contact' | split: ',' -%}
        {%- capture fb_url_string -%}
          {{ routes.all_products_collection_url }},/pages/manifesto,{{ circle_url }},/pages/contact
        {%- endcapture -%}
        {%- assign fb_urls = fb_url_string | strip | split: ',' -%}

        {%- for title in fb_titles -%}
          {%- assign fb_url = fb_urls[forloop.index0] | strip -%}
          {%- assign is_circle = false -%}
          {%- if fb_url == circle_url -%}{%- assign is_circle = true -%}{%- endif -%}
          <li class="sr-nav__row{% if is_circle %} sr-nav__row--circle{% endif %}">
            <a class="sr-nav__link" href="{{ fb_url }}"
               {% if fb_url contains '://' %}target="_blank" rel="noopener"{% endif %}>
              <span class="sr-nav__no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="sr-nav__label">{{ title }}</span>
              {%- if is_circle -%}<span class="sr-nav__vip">{{ section.settings.vip_badge }}</span>{%- endif -%}
            </a>
          </li>
        {%- endfor -%}

      {%- endif -%}
    </ul>

    <div class="sr-drawer__foot">

      <div>
        {%- if section.settings.contact_kicker != blank -%}
          <p class="sr-drawer__kicker">{{ section.settings.contact_kicker }}</p>
        {%- endif -%}
        {%- if section.settings.contact_email != blank -%}
          <a class="sr-drawer__line" href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
        {%- endif -%}
        {%- if section.settings.contact_note != blank -%}
          <span class="sr-drawer__line">{{ section.settings.contact_note }}</span>
        {%- endif -%}
      </div>

      <div>
        {%- if section.settings.locale_kicker != blank -%}
          <p class="sr-drawer__kicker">{{ section.settings.locale_kicker }}</p>
        {%- endif -%}
        {%- if section.settings.locale_line != blank -%}
          <address class="sr-drawer__meta">{{ section.settings.locale_line }}</address>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

<script>
(function(){
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if(!root) return;

  var head    = root.querySelector('[data-sr-head]');
  var drawer  = root.querySelector('[data-sr-drawer]');
  var opener  = root.querySelector('[data-sr-open]');
  var closer  = root.querySelector('[data-sr-close]');
  var count   = root.querySelector('[data-sr-count]');
  var countLb = root.querySelector('[data-sr-count-label]');
  var lastPad = '';

  {%- if mode != 'solid' -%}
  /* ---------- contrast state ---------- */
  var THRESHOLD = {{ section.settings.scroll_threshold }};
  var LIGHT_CUT = 0.55;
  var tones = [];
  var ticking = false;

  function relLum(r,g,b){
    var c = [r,g,b].map(function(v){
      v = v/255;
      return v <= 0.03928 ? v/12.92 : Math.pow((v+0.055)/1.055, 2.4);
    });
    return 0.2126*c[0] + 0.7152*c[1] + 0.0722*c[2];
  }

  /* null for a background that is transparent or nearly so */
  function paintedColour(el){
    var m = getComputedStyle(el).backgroundColor.match(/rgba?\(([^)]+)\)/);
    if(!m) return null;
    var p = m[1].split(',').map(parseFloat);
    if(p.length > 3 && p[3] < 0.5) return null;
    return p;
  }

  /* A section wrapper is usually unpainted; the tone lives on its first
     child (.sr-hero, .sr-man, .sr-circle). Walk one level down. */
  function toneOf(sec){
    var nodes = [sec].concat(Array.prototype.slice.call(sec.children));
    for(var i = 0; i < nodes.length; i++){
      var c = paintedColour(nodes[i]);
      if(c) return relLum(c[0],c[1],c[2]) > LIGHT_CUT ? 'light' : 'dark';
    }
    return 'dark';
  }

  function indexTones(){
    tones = Array.prototype.filter.call(
      document.querySelectorAll('[id^="shopify-section-"]'),
      function(el){
        return el !== root && el.id.indexOf('shopify-section-group-') !== 0;
      }
    ).map(function(el){ return { el: el, tone: toneOf(el) }; });
  }

  function toneUnderBar(){
    var y = head.getBoundingClientRect().bottom - 2;
    for(var i = 0; i < tones.length; i++){
      var r = tones[i].el.getBoundingClientRect();
      if(r.top <= y && r.bottom > y) return tones[i].tone;
    }
    return 'dark';
  }

  function update(){
    var y = window.pageYOffset || document.documentElement.scrollTop || 0;
    {%- if mode == 'veil' -%}
      head.classList.toggle('is-veiled', y > THRESHOLD);
    {%- endif -%}
    {%- if mode == 'adaptive' -%}
      head.classList.toggle('is-inverted', y > THRESHOLD && toneUnderBar() === 'light');
    {%- endif -%}
  }

  function onScroll(){
    if(ticking) return;
    ticking = true;
    requestAnimationFrame(function(){ update(); ticking = false; });
  }

  indexTones();
  update();
  window.addEventListener('scroll', onScroll, { passive:true });
  window.addEventListener('resize', onScroll, { passive:true });
  /* Sections are swapped in and out live in the theme editor. */
  document.addEventListener('shopify:section:load', function(){ indexTones(); update(); });
  {%- endif -%}

  /* ---------- drawer ---------- */
  var FOCUSABLE = 'a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])';

  function lockScroll(){
    var gap = window.innerWidth - document.documentElement.clientWidth;
    lastPad = document.body.style.paddingRight;
    document.body.style.overflow = 'hidden';
    if(gap > 0) document.body.style.paddingRight = gap + 'px';
  }
  function unlockScroll(){
    document.body.style.overflow = '';
    document.body.style.paddingRight = lastPad;
  }

  function open(){
    drawer.hidden = false;
    /* next frame so the transition has a start state to run from */
    requestAnimationFrame(function(){ drawer.classList.add('is-open'); });
    opener.setAttribute('aria-expanded','true');
    lockScroll();
    var first = drawer.querySelector(FOCUSABLE);
    if(first) first.focus();
    document.addEventListener('keydown', onKey);
  }

  function close(){
    drawer.classList.remove('is-open');
    opener.setAttribute('aria-expanded','false');
    unlockScroll();
    document.removeEventListener('keydown', onKey);
    opener.focus();
    window.setTimeout(function(){
      if(!drawer.classList.contains('is-open')) drawer.hidden = true;
    }, 520);
  }

  function onKey(e){
    if(e.key === 'Escape'){ e.preventDefault(); close(); return; }
    if(e.key !== 'Tab') return;
    var items = Array.prototype.filter.call(
      drawer.querySelectorAll(FOCUSABLE),
      function(el){ return el.offsetParent !== null; }
    );
    if(!items.length) return;
    var first = items[0], last = items[items.length - 1];
    if(e.shiftKey && document.activeElement === first){ e.preventDefault(); last.focus(); }
    else if(!e.shiftKey && document.activeElement === last){ e.preventDefault(); first.focus(); }
  }

  opener.addEventListener('click', open);
  drawer.addEventListener('touchstart', function(){}, { passive:true });
  closer.addEventListener('click', close);
  drawer.addEventListener('click', function(e){
    if(e.target === drawer) close();
  });

  /* Close when the theme editor swaps this section out. */
  document.addEventListener('shopify:section:unload', function(e){
    if(e.detail && e.detail.sectionId === '{{ section.id }}') unlockScroll();
  });

  /* ---------- bag count ---------- */
  function setCount(n){
    if(!count) return;
    count.textContent = n;
    count.hidden = (n === 0);
    if(countLb) countLb.textContent = '{{ section.settings.bag_label | escape }} (' + n + ')';
  }

  function refreshCount(){
    fetch('{{ routes.cart_url }}.js', { headers:{ 'Accept':'application/json' }, credentials:'same-origin' })
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(c){ if(c) setCount(c.item_count); })
      .catch(function(){});
  }

  /* Fires after a bfcache restore, where the cached count is stale. */
  window.addEventListener('pageshow', function(e){ if(e.persisted) refreshCount(); });
  /* Hook for any future AJAX add-to-cart: document.dispatchEvent(new Event('cart:updated')) */
  document.addEventListener('cart:updated', refreshCount);
})();
</script>

{% schema %}
{
  "name": "SR — Header",
  "tag": "header",
  "class": "sr-section",
  "settings": [
    { "type": "header", "content": "Wordmark" },
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Leave empty to set the wordmark in Cormorant Garamond." },
    { "type": "text", "id": "wordmark", "label": "Wordmark text", "default": "Spring Renaissance" },
    { "type": "range", "id": "logo_size_mobile", "label": "Wordmark size (mobile)", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "logo_size_desktop", "label": "Wordmark size (desktop)", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 24 },

    { "type": "header", "content": "Index trigger" },
    { "type": "select", "id": "trigger_glyph", "label": "Trigger mark", "options": [
        { "value": "rules", "label": "Index rules — three hairlines" },
        { "value": "tulip", "label": "Tulip — botanical outline" }
      ], "default": "rules",
      "info": "Rules read as navigation at a glance. The tulip is more distinctive but less obvious; keep the label on if you use it." },
    { "type": "text", "id": "trigger_label", "label": "Trigger label", "default": "Index" },
    { "type": "text", "id": "drawer_eyebrow", "label": "Drawer eyebrow", "default": "Index" },
    { "type": "text", "id": "close_label", "label": "Close label", "default": "Close" },

    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "main_menu", "label": "Menu", "info": "Leave empty to fall back to Collection, Manifesto, Renaissance Circle, Contact." },
    { "type": "text", "id": "vip_badge", "label": "Circle badge", "default": "VIP" },

    { "type": "header", "content": "Renaissance Circle" },
    { "type": "checkbox", "id": "show_circle", "label": "Show Circle monogram", "default": true },
    { "type": "url", "id": "circle_url", "label": "Circle URL", "info": "Falls back to the Patron Membership page when empty." },
    { "type": "text", "id": "circle_label", "label": "Circle label (screen readers)", "default": "Renaissance Circle" },

    { "type": "header", "content": "Bag" },
    { "type": "url", "id": "account_url", "label": "Account URL", "info": "Leave empty for the member portal, https://club.springrenaissance.store." },
    { "type": "text", "id": "account_label", "label": "Account label (screen readers)", "default": "Account" },
    { "type": "text", "id": "bag_label", "label": "Bag label (screen readers)", "default": "Bag" },

    { "type": "header", "content": "Behaviour" },
    { "type": "select", "id": "mode", "label": "Contrast mode", "options": [
        { "value": "solid", "label": "Solid — opaque at all times" },
        { "value": "veil", "label": "Veil — clear over the hero, opaque once scrolled" },
        { "value": "adaptive", "label": "Adaptive — clear throughout, ink inverts" }
      ], "default": "veil",
      "info": "Veil is the safe editorial default. Adaptive keeps the page full-bleed and flips the ink to dark over light sections." },
    { "type": "checkbox", "id": "scrim", "label": "Scrim behind a clear bar", "default": true, "info": "A soft gradient so white type survives a light-toned hero image." },
    { "type": "range", "id": "scrim_strength", "label": "Scrim strength", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 45 },
    { "type": "range", "id": "veil_opacity", "label": "Veil opacity", "min": 60, "max": 100, "step": 2, "unit": "%", "default": 92, "info": "Applies the Background colour once the bar turns opaque." },
    { "type": "checkbox", "id": "overlay_home", "label": "Overlay the home page hero", "default": true, "info": "Ignored in Solid mode, where content would sit under an opaque bar." },
    { "type": "range", "id": "scroll_threshold", "label": "Scroll trigger", "min": 0, "max": 200, "step": 5, "unit": "px", "default": 25 },

    { "type": "header", "content": "Colour & layout" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1A1918" },
    { "type": "color", "id": "text_color", "label": "Text on dark", "default": "#FBFBF9" },
    { "type": "color", "id": "text_color_dark", "label": "Text on light", "default": "#1A1918", "info": "Used by Adaptive mode over light sections." },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#9A7B52" },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 900, "max": 1800, "step": 20, "unit": "px", "default": 1440 },
    { "type": "range", "id": "height_mobile", "label": "Height (mobile)", "min": 48, "max": 96, "step": 2, "unit": "px", "default": 62 },
    { "type": "range", "id": "height_desktop", "label": "Height (desktop)", "min": 56, "max": 120, "step": 2, "unit": "px", "default": 78 },

    { "type": "header", "content": "Drawer surface" },
    { "type": "color", "id": "drawer_bg", "label": "Drawer background", "default": "#F7F4EF", "info": "Warm off-white. The drawer is frosted glass, so this tints whatever sits behind it." },
    { "type": "color", "id": "drawer_ink", "label": "Drawer text", "default": "#1A1918" },
    { "type": "range", "id": "drawer_opacity", "label": "Drawer opacity", "min": 74, "max": 100, "step": 2, "unit": "%", "default": 86, "info": "Lower reads as glass but loses contrast over dark sections. Raise to 92 if the menu opens over dark content." },

    { "type": "header", "content": "Drawer colophon" },
    { "type": "text", "id": "contact_kicker", "label": "Contact kicker", "default": "Correspondence" },
    { "type": "text", "id": "contact_email", "label": "Email", "default": "studio@springrenaissance.store" },
    { "type": "text", "id": "contact_note", "label": "Contact note", "default": "Replies within two business days." },
    { "type": "text", "id": "locale_kicker", "label": "Locale kicker", "default": "Studio" },
    { "type": "text", "id": "locale_line", "label": "Locale line", "default": "New York · Est. 2026" }
  ],
  "presets": [{ "name": "SR — Header" }]
}
{% endschema %}