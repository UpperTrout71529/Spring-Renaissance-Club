    "sr_patron_faq_prbhgK": {
      "type": "sr-patron-faq",
      "blocks": {
        "question_EPjpeL": {
          "type": "question",
          "settings": {
            "question": "How does the $20 monthly membership work?",
            "answer": "<p>Each month adds $20 of credit to your account. The credit is yours to spend on any release, and it accumulates toward the seasonal capsule delivered at the close of each quarter.</p>",
            "pin": "",
            "open_by_default": true
          }
        },
        "question_fDQnUH": {
          "type": "question",
          "settings": {
            "question": "Can I pause or cancel at any time?",
            "answer": "<p>Yes, from your account, in two clicks. There is no minimum term, no cancellation fee and no call to make. Pausing keeps your accrued credit intact.</p>",
            "pin": "No lock-in",
            "open_by_default": false
          }
        },
        "question_PWimBx": {
          "type": "question",
          "settings": {
            "question": "Does my monthly credit ever expire?",
            "answer": "<p>No. Credit carries forward in full for as long as your membership is active, and it applies to any release at member pricing.</p>",
            "pin": "Carries forward in full",
            "open_by_default": false
          }
        },
        "question_7y6h9f": {
          "type": "question",
          "settings": {
            "question": "When does my welcome vase arrive?",
            "answer": "<p>Le Vase Livre is dispatched within 24 to 48 hours of enrolment, individually numbered between 001 and 300, in hardcover packaging with a digital certificate of authenticity.</p>",
            "pin": "",
            "open_by_default": false
          }
        },
        "question_cqgW4T": {
          "type": "question",
          "settings": {
            "question": "What do I need to receive the seasonal capsule?",
            "answer": "<p>An active membership for at least two months before the quarter closes. Enrol later than that and the capsule ships to the members who held their place through the quarter; yours begins accruing for the next one.</p>",
            "pin": "Two months before quarter end",
            "open_by_default": false
          }
        },
        "question_9UdLzM": {
          "type": "question",
          "settings": {
            "question": "How does member pricing apply to future releases?",
            "answer": "<p>Member rates of 25 to 50 percent are applied automatically at checkout while your membership is active. Nothing to enter and no code to remember.</p>",
            "pin": "",
            "open_by_default": false
          }
        },
        "question_9mNdcy": {
          "type": "question",
          "settings": {
            "question": "What happens to my allocation on limited editions?",
            "answer": "<p>Your piece is reserved before the public release opens and held for a set window. You are notified by correspondence; if you pass, the allocation returns to the run.</p>",
            "pin": "",
            "open_by_default": false
          }
        }
      },
