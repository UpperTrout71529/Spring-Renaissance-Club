            "open_by_default": true
          }
        },
        "question_fDQnUH": {
          "type": "question",
          "settings": {
            "question": "How do I cancel?",
            "answer": "<p>Online, in your account, at any time. Cancelling takes effect at the end of the month you have paid for.</p>",
            "pin": "Cancel online",
            "open_by_default": false
          }
        },
        "question_PWimBx": {
          "type": "question",
          "settings": {
            "question": "What happens to my credits if I cancel?",
            "answer": "<p>They stay usable for 30 days after the end of your last paid month, then they expire.</p>",
            "pin": "Usable 30 days after",
            "open_by_default": false
          }
        },
        "question_7y6h9f": {
          "type": "question",
          "settings": {
            "question": "What is the sealed piece?",
            "answer": "<p>After you join, you choose your first piece from a small sealed selection — revealed only after joining. It is included in the joining fee.</p>",
            "pin": "",
            "open_by_default": false
          }
        },
        "question_cqgW4T": {
          "type": "question",
          "settings": {
            "question": "What are seasonal capsules?",
            "answer": "<p>Seasonal capsules are reserved for members. Skip lets you pass on a season's capsule; your membership and monthly credits continue as usual, and nothing is refunded.</p>",
            "pin": "",
            "open_by_default": false
          }
        },
        "question_9UdLzM": {
          "type": "question",
          "settings": {
            "question": "What is the Circle price?",
            "answer": "<p>25% off eligible pieces, applied at checkout with your Circle email while your membership is active. It does not apply to Small Pleasures, gift cards or seasonal capsules.</p>",
            "pin": "",
            "open_by_default": false
          }
        },
        "question_9mNdcy": {
          "type": "question",
          "settings": {
            "question": "What is early access?",
            "answer": "<p>When a new piece has early access, members can pre-order it from their account before its public release. One per member.</p>",
            "pin": "",
            "open_by_default": false
          }
